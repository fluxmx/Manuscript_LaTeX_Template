# Normalize source text without transforming binary assets.
* text=auto
*.tex text eol=lf
*.sty text eol=lf
*.bst text eol=lf
*.bib text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
Makefile text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
